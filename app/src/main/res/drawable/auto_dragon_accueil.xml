<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fond plein format : Android Auto recadre les icônes en vignette carrée. -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:type="radial" android:gradientRadius="220dp"
                android:centerX="50%" android:centerY="42%"
                android:startColor="#FFB58CFF" android:centerColor="#FF5423B5"
                android:endColor="#FF100824" />
            <stroke android:width="2dp" android:color="#FFE0C7FF" />
        </shape>
    </item>
    <item android:inset="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#99D7B5FF" />
        </shape>
    </item>
    <item android:inset="12dp">
        <bitmap android:src="@drawable/dragon_tete" android:gravity="center" />
    </item>
</layer-list>