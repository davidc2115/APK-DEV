<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐 Connexion Comptes Google et Email"
            android:textColor="@color/cyan_accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Connectez votre compte Google pour lire et envoyer vos e-mails directement."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- OPTION 1 : Connexion Web Google 1-Clic -->
        <TextView
            android:id="@+id/btnOpenWebGoogleLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_mic_button"
            android:gravity="center"
            android:text="🌐 OUVRIR LA PAGE DE CONNEXION GOOGLE"
            android:textColor="@color/background_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- OPTION 2 : Connexion directe avec Adresse & Mot de Passe -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adresse Email Google / Gmail :"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input"
            android:hint="exemple@gmail.com"
            android:inputType="textEmailAddress"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mot de passe Google (habituel ou mot de passe d'application 16 lettres) :"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input"
            android:hint="Votre mot de passe..."
            android:inputType="textPassword"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <TextView
            android:id="@+id/btnConnectGoogle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:text="✅ CONNECTER ET TESTER LE COMPTE GOOGLE"
            android:textColor="@color/cyan_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/testResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/cyan_accent"
            android:textSize="13sp" />

        <!-- Guide App Password -->
        <TextView
            android:id="@+id/btnOpenGooglePassGuide"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="🔑 Obtenir un Mot de Passe d'App Google 16 lettres (si double-étape activée)"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="16dp" />

        <!-- Comptes actifs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="📋 Comptes Google Connectés"
            android:textColor="@color/cyan_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/accountsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
