<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/cyan_accent"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Couleur du mode vocal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Couleur du mode vocal"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">

            <TextView android:id="@+id/colorCyan" style="@style/ColorSwatch" android:background="#00E5FF" />
            <TextView android:id="@+id/colorRed" style="@style/ColorSwatch" android:background="#FF3B30" />
            <TextView android:id="@+id/colorBlue" style="@style/ColorSwatch" android:background="#2979FF" />
            <TextView android:id="@+id/colorPurple" style="@style/ColorSwatch" android:background="#B388FF" />
            <TextView android:id="@+id/colorGold" style="@style/ColorSwatch" android:background="#FFC400" />
            <TextView android:id="@+id/colorGreen" style="@style/ColorSwatch" android:background="#00E676" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Style de l'orbe vocale"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/styleOrbPulse"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Orbe pulsante"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/styleOrbNetwork"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Sphère réseau"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fournisseur IA"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/providerSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:popupBackground="@color/surface_dark"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <!-- Section API distante -->
        <LinearLayout
            android:id="@+id/cloudSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL de l'API"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/baseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:inputType="textUri"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nom du modèle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/modelInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clé API (laisser vide pour une IA locale sur PC)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="sk-..."
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Section modèle local (hors-ligne) -->
        <LinearLayout
            android:id="@+id/localSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Remarque : Ollama ne fonctionne que sur PC/Mac (choisis « IA locale sur PC » dans la liste au-dessus pour ça). Ici, Gemma tourne directement sur ton téléphone, sans PC."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/downloadNoKeyButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="TÉLÉCHARGER SANS COMPTE (miroir communautaire)"
                android:textColor="@color/background_dark"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_mic_button"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Non officiel, peut disparaître ou changer sans préavis. Pour un modèle garanti par Google, utilise l'option ci-dessous (jeton gratuit requis, licence Gemma oblige)."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jeton Hugging Face (optionnel, requis pour le modèle officiel)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/hfTokenInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="hf_... (laisser vide si tu utilises le miroir sans compte)"
                android:textColorHint="@color/text_secondary"
                android:inputType="textPassword"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Crée un compte gratuit sur huggingface.co → Settings → Access Tokens → New token (lecture seule). Puis accepte la licence Gemma sur la page du modèle litert-community/Gemma3-1B-IT."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/downloadRecommendedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="TÉLÉCHARGER GEMMA 3 1B OFFICIEL (≈550 Mo)"
                android:textColor="@color/cyan_accent"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ou coller l'URL d'un autre modèle .task (plus puissant)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/customModelUrlInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:hint="https://huggingface.co/.../modele.task"
                android:textColorHint="@color/text_secondary"
                android:inputType="textUri"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/downloadCustomButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="TÉLÉCHARGER CETTE URL"
                android:textColor="@color/cyan_accent"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/downloadProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/cyan_accent"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/localModelPathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:text="Aucun modèle importé"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/pickModelButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="OU IMPORTER UN FICHIER .task MANUELLEMENT"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="ENREGISTRER"
            android:textColor="@color/background_dark"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_mic_button"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="💡 Pour une IA locale sur PC : installe Ollama (ollama.com), lance 'ollama run llama3.1', puis renseigne l'adresse IP locale de ton PC. Téléphone et PC doivent être sur le même Wi-Fi."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</ScrollView>
