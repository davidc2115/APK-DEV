<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050608">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <com.jarvis.assistant.OrbView
            android:id="@+id/orbView"
            android:layout_width="240dp"
            android:layout_height="240dp" />

        <TextView
            android:id="@+id/voiceStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Je vous écoute…"
            android:textColor="#E8F6FF"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/voiceTranscriptText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text=""
            android:textColor="#7FA8B8"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/closeVoiceButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:text="✕"
        android:textColor="#E8F6FF"
        android:textSize="20sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/micToggleButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:text="🎤"
        android:textSize="26sp"
        android:gravity="center"
        android:background="@drawable/bg_mic_button" />

</FrameLayout>
