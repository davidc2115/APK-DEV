<?xml version="1.0" encoding="utf-8"?>
<!-- Widget d'écran d'accueil : tête du dragon, prochain rendez-vous, bouton pour parler à JARVIS. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fond"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_dragon"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:contentDescription="JARVIS"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_dragon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.25"
            android:text="J.A.R.V.I.S"
            android:textColor="#FFB06CFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Touche pour me parler"
            android:textColor="#FFE6F4FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_parler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_bouton"
            android:fontFamily="monospace"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="🎙️  PARLER"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
